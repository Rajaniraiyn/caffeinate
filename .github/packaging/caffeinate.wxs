<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="caffeinate" Manufacturer="Rajaniraiyn" Version="$(Version)"
           UpgradeCode="A791319F-707D-4711-B6E3-B3D84209782D" Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer version of caffeinate is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="InstallFolder" Name="caffeinate">
        <Component Id="Command" Guid="A5987AAF-57C6-43BF-9B62-2AE14566533F">
          <File Source="$(Binary)" />
          <File Source="LICENSE-MIT" />
          <File Source="LICENSE-APACHE" />
          <RegistryValue Root="HKCU" Key="Software\Rajaniraiyn\caffeinate"
                         Name="Installed" Type="integer" Value="1" KeyPath="yes" />
          <Environment Name="PATH" Action="set" Part="last" Value="[InstallFolder]" />
          <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="Caffeinate" Title="caffeinate">
      <ComponentRef Id="Command" />
    </Feature>
  </Package>
</Wix>
